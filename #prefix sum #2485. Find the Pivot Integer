#prefix sum
#2485. Find the Pivot Integer

class Solution:
    def pivotInteger(self, n: int) -> int:
              
        total=0
        for i in range(1,n+1):
            total+=i
            
            
            
        prefix=0

        for i in range(1, n+1):
            prefix+=i
            right=total-prefix+i
            
            if prefix==right:
                return i
        return -1


###test case###
Input: n = 8
Output: 6
Explanation: 6 is the pivot integer since: 1 + 2 + 3 + 4 + 5 + 6 = 6 + 7 + 8 = 21.
