451. Sort Characters By Frequency


class Solution:
    def frequencySort(self, s: str) -> str:
        freq=defaultdict(int)
        for i in s:
            freq[i]+=1

        sorted_dict=sorted(freq.items(), key =lambda x:x[1],reverse=True)
        result=""
        for c , f in sorted_dict:
            result+=c*f
        return result
