#twopointers
#27. Remove Element
class Solution:
    def removeElement(self, nums: List[int], val: int) -> int:
        j=0
        for i in range(len(nums)):
            if val!=nums[i]:
                nums[j]=nums[i]
                j+=1
        
        return j

#testcase
Input: nums = [3,2,2,3], val = 3
Output: 2, nums = [2,2,_,_]
